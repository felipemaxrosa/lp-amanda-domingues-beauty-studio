# === Sanity ===
# Preencha quando criar o projeto em https://www.sanity.io (ou com `npx sanity init`).
# Enquanto vazio, o site usa o conteúdo "semente" em lib/content.seed.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# === Site ===
# URL pública (usada em metadata/SEO/sitemap).
NEXT_PUBLIC_SITE_URL=https://amandadominguesbeauty.pt

# === Analytics ===
# Google Analytics 4 (GA4). Opcional — já tem default no código e só carrega
# em produção (dev/preview não contam). Definir aqui apenas para substituir o id.
NEXT_PUBLIC_GA_ID=G-DVECEY1JY7
